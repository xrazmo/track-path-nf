// Local (non-SLURM, single-workstation) override config for testing the
// pipeline end-to-end with Singularity. Include alongside main.config:
//   nextflow run main.nf -c main.config -c local_test.config -profile local ...

params {
    dataCacheDir = "${baseDir}/.data_cache"
    assetsDir    = "${baseDir}/assets"
}

profiles {
    local {
        process.executor   = 'local'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${baseDir}/.singularity_cache"
        // GENE_DIFF (modules/genediff) has no `container` directive, only
        // `conda`, so it needs conda enabled alongside Singularity or it
        // runs with the bare host Python and fails on missing Biopython.
        conda.enabled = true
        conda.useMamba = true
        conda.cacheDir = "${baseDir}/.conda_cache"
        executor.queueSize = 4
        executor.cpus = 20
        executor.memory = '56 GB'
    }
}

process {
    // Cap resource requests to what this workstation actually has
    // (24 cores / 62GB RAM) instead of the SLURM-era per-job sizing.
    cpus   = { Math.min(4, 20) }
    memory = { 8.GB }

    // Retry once on transient failures (e.g. a container tool segfaulting
    // under momentary resource contention when several DB updates and
    // SPAdes run concurrently) instead of aborting the whole run.
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName:SPADES {
        cpus = 8
        memory = 16.GB
    }
    withName:RGI_MAIN {
        cpus = 8
        memory = 8.GB
    }
}
